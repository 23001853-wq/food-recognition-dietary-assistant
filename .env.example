APP_ENV=development
DATABASE_URL=postgresql+psycopg://food_user:CHANGE_ME@localhost:5432/food_assistant
APP_TIMEZONE=Asia/Ho_Chi_Minh
MODEL_POINTER=artifacts/production/current.json
UPLOAD_DIR=storage/uploads
TEMP_DIR=storage/temp
MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=20000000
SAVE_UPLOADED_IMAGES=false
SAVE_PREDICTION_HISTORY=false
INFERENCE_DEVICE=auto
API_BASE_URL=http://127.0.0.1:8000
ALLOW_MOCK_AI=true
DEFAULT_MODEL=mock

# Use the same password in DATABASE_URL and POSTGRES_PASSWORD.
POSTGRES_USER=food_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=food_assistant
POSTGRES_PORT=5432
# Reserved for future integration tests; never use the application database.
TEST_DATABASE_URL=postgresql+psycopg://food_user:CHANGE_ME@localhost:5432/food_assistant_test
