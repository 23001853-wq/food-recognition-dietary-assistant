erDiagram
    users ||--o{ meal_logs : owns
    users ||--o{ prediction_history : requests
    model_versions o|--o{ prediction_history : audits
    meal_logs ||--|{ meal_items : contains
    prediction_history o|--o{ meal_items : referenced_by
    food_classes o|--o{ meal_items : confirmed_as
    food_classes ||--o{ food_nutrition_mappings : mapped_by
    nutrition_foods ||--o{ food_nutrition_mappings : matched_to
    food_classes {
        string dataset_key
        string display_name_en
        string display_name_vi
        string label_version
        boolean is_active
        uuid id PK
        datetime created_at
    }
    model_versions {
        string model_name
        string run_id
        string dataset_version
        integer num_classes
        text artifact_dir
        jsonb metrics_json
        boolean is_production
        uuid id PK
        datetime created_at
    }
    nutrition_foods {
        string name
        numeric kcal_per_100g
        numeric protein_per_100g
        numeric carbohydrate_per_100g
        numeric fat_per_100g
        string source_name
        string source_record_id
        text provenance_url
        string source_version
        string unit
        datetime retrieved_at
        numeric small_grams
        numeric medium_grams
        numeric large_grams
        text mapping_note
        boolean reviewed
        datetime updated_at
        uuid id PK
        datetime created_at
    }
    users {
        string display_name
        string email
        uuid id PK
        datetime created_at
    }
    food_nutrition_mappings {
        uuid food_class_id FK
        uuid nutrition_food_id FK
        boolean is_default
        text confidence_note
        uuid id PK
        datetime created_at
    }
    meal_logs {
        uuid user_id FK
        uuid client_request_id
        string request_hash
        date consumed_on
        string meal_type
        text notes
        datetime updated_at
        uuid id PK
        datetime created_at
    }
    prediction_history {
        uuid user_id FK
        uuid model_version_id FK
        text image_path
        string image_sha256
        jsonb crop_box_json
        jsonb response_json
        boolean is_mock
        uuid id PK
        datetime created_at
    }
    meal_items {
        uuid meal_log_id FK
        uuid confirmed_food_class_id FK
        string custom_food_name
        uuid prediction_id FK
        string portion_size
        numeric estimated_grams
        numeric kcal_per_100g_snapshot
        numeric estimated_kcal
        numeric protein_g
        numeric carbohydrate_g
        numeric fat_g
        text nutrition_source_snapshot
        jsonb nutrition_snapshot
        string calculation_method
        boolean is_user_corrected
        text notes
        datetime updated_at
        uuid id PK
        datetime created_at
    }
