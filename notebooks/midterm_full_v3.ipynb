   "source": [
    "## Full-v3 Processing — riêng biệt và opt-in\n",
    "\n",
    "Một ảnh được decode một lần trong lượt chạy; các phép biến đổi chạy tuần tự trên ảnh đó và chỉ ghi metrics nhỏ. JSONL được fsync từng record, checkpoint atomic, resume chỉ nhận record đúng config/source. Không lưu ảnh biến đổi. Status chỉ PASS khi mọi ID được xử lý thành công."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "RUN_FULL_PIPELINE=False  # Chỉ đổi thành True khi chủ động xử lý cả dataset.\n",
    "FULL_TECHNIQUES=[\"rgb_channels\",\"bgr_conversion\",\"grayscale\",\"hsv_channels\",\"layout_normalization\",\"brightness\",\"contrast\",\"gamma\",\"resize\",\"center_crop\",\"horizontal_flip\",\"rotation\",\"gaussian_blur\",\"median_filter\",\"gaussian_noise_filter\",\"salt_pepper_filter\",\"threshold\",\"erosion\",\"dilation\",\"opening\",\"closing\",\"sobel\",\"canny\",\"connected_components\",\"regions\",\"classical_segmentation\",\"hog\"]\n",
    "RUN_CONFIG={\"source\":DATASET_FINGERPRINT,\"manifest\":MANIFEST_SHA256,\"techniques\":FULL_TECHNIQUES,\"params\":{name:params(name) for name in FULL_TECHNIQUES}}\n",
    "RUN_HASH=hashlib.sha256(json.dumps(RUN_CONFIG,sort_keys=True,default=list).encode()).hexdigest()\n",
    "\n",
    "def atomic_json(path,value):\n",
    "    \"\"\"Ghi trạng thái JSON atomically tại cùng filesystem.\"\"\"\n",
    "    path.parent.mkdir(parents=True,exist_ok=True)\n",
    "    with tempfile.NamedTemporaryFile(mode=\"w\",encoding=\"utf-8\",prefix=\".state-\",suffix=\".tmp\",dir=path.parent,delete=False) as handle:\n",
    "        temp=Path(handle.name); json.dump(value,handle,ensure_ascii=False,indent=2); handle.flush(); os.fsync(handle.fileno())\n",
    "    try: os.replace(temp,path)\n",
    "    finally:\n",
    "        if temp.exists(): temp.unlink()\n",
    "\n",
    "def _run_full_v3_processing_locked(resume=True,checkpoint_interval=100):\n",
    "    \"\"\"Xử lý tuần tự manifest, checkpoint JSONL và resume fail-closed.\"\"\"\n",
    "    if isinstance(checkpoint_interval,bool) or not isinstance(checkpoint_interval,int) or checkpoint_interval<1: raise ValueError(\"checkpoint_interval phải dương.\")\n",
    "    RUN_DIR.mkdir(parents=True,exist_ok=True); records_path=RUN_DIR/\"records.jsonl\"\n",
    "    checkpoint_path=RUN_DIR/\"checkpoint.json\"; summary_path=RUN_DIR/\"summary.json\"; records_path.touch(exist_ok=True)\n",
    "    ids={row[\"image_id\"] for row in ROWS}; done=set()\n",
    "    if records_path.stat().st_size and not resume: raise FileExistsError(\"Run đã có records; resume=True required.\")\n",
    "    if resume:\n",
    "        with records_path.open(encoding=\"utf-8\") as reader:\n",
    "            for number,line in enumerate(reader,start=1):\n",
    "                try: record=json.loads(line)\n",
    "                except json.JSONDecodeError as error: raise ValueError(f\"Corrupt JSONL line {number}; fail closed.\") from error\n",
    "                if record.get(\"config_hash\")!=RUN_HASH or record.get(\"image_id\") not in ids or record[\"image_id\"] in done or record.get(\"status\") not in {\"SUCCESS\",\"FAILED\"}: raise ValueError(f\"Incompatible checkpoint line {number}.\")\n",
    "                done.add(record[\"image_id\"])\n",
    "    start=time.time(); added=0\n",
    "    with records_path.open(\"a\",encoding=\"utf-8\",newline=\"\\n\") as writer:\n",
    "        for row in ROWS:\n",
    "            if row[\"image_id\"] in done: continue\n",
    "            try:\n",
    "                image=read_rgb(row); measurements={}\n",
    "                for name in FULL_TECHNIQUES:\n",
    "                    _,metrics=compute(image,name); measurements[name]={k:v for k,v in metrics.items() if k!=\"output_shapes\"}\n",
    "                record={\"image_id\":row[\"image_id\"],\"split\":row[\"split\"],\"class_id\":int(row[\"class_id\"]),\"class_name\":row[\"class_key\"],\"shape\":list(image.shape),\"techniques\":measurements,\"status\":\"SUCCESS\"}\n",
    "            except Exception as error: record={\"image_id\":row[\"image_id\"],\"split\":row[\"split\"],\"class_id\":int(row[\"class_id\"]),\"class_name\":row[\"class_key\"],\"status\":\"FAILED\",\"error_type\":type(error).__name__,\"error\":str(error)}\n",
    "            record[\"config_hash\"]=RUN_HASH; writer.write(json.dumps(record,ensure_ascii=False,sort_keys=True)+\"\\n\"); writer.flush(); os.fsync(writer.fileno())\n",
    "            done.add(row[\"image_id\"]); added+=1\n",
    "            if added%checkpoint_interval==0:\n",
    "                atomic_json(checkpoint_path,{\"status\":\"INCOMPLETE\",\"expected\":len(ROWS),\"completed\":len(done),\"fingerprint\":DATASET_FINGERPRINT,\"manifest_sha256\":MANIFEST_SHA256,\"config_hash\":RUN_HASH,\"last_id\":row[\"image_id\"]})\n",
    "                print(f\"Progress {len(done):,}/{len(ROWS):,}\")\n",
    "    counts=Counter(); classes=Counter(); success=0; failed=0\n",
    "    with records_path.open(encoding=\"utf-8\") as reader:\n",
    "        for number,line in enumerate(reader,start=1):\n",
    "            try: record=json.loads(line)\n",
    "            except json.JSONDecodeError as error: raise ValueError(f\"Corrupt record line {number}.\") from error\n",
    "            if record.get(\"config_hash\")!=RUN_HASH: raise ValueError(\"Record config mismatch.\")\n",
    "            if record[\"status\"]==\"SUCCESS\": success+=1; counts[record[\"split\"]]+=1; classes[record[\"class_name\"]]+=1\n",
    "            else: failed+=1\n",
    "    status=\"PASS\" if len(done)==len(ROWS) and success==len(ROWS) and failed==0 else \"INCOMPLETE\"\n",
    "    summary={\"status\":status,\"expected\":len(ROWS),\"processed\":len(done),\"success\":success,\"failed\":failed,\"coverage\":len(done)/len(ROWS),\"split_counts\":dict(counts),\"class_counts\":dict(classes),\"technique_count\":len(FULL_TECHNIQUES),\"fingerprint\":DATASET_FINGERPRINT,\"manifest_sha256\":MANIFEST_SHA256,\"config_hash\":RUN_HASH,\"elapsed_seconds\":time.time()-start}\n",
    "    atomic_json(summary_path,summary); atomic_json(checkpoint_path,{\"status\":status,\"expected\":len(ROWS),\"completed\":len(done),\"success\":success,\"failed\":failed,\"fingerprint\":DATASET_FINGERPRINT,\"manifest_sha256\":MANIFEST_SHA256,\"config_hash\":RUN_HASH})\n",
    "    print(json.dumps(summary,ensure_ascii=False,indent=2)); return summary\n",
    "\n",
    "def run_full_v3_processing(resume=True,checkpoint_interval=100):\n",
    "    \"\"\"Run or resume under a resource-scoped cross-process lock.\"\"\"\n",
    "    with resource_lock(RUN_DIR/RUN_HASH,timeout_seconds=0):\n",
    "        return _run_full_v3_processing_locked(resume,checkpoint_interval)\n",
    "\n",
    "if RUN_FULL_PIPELINE: FULL_SUMMARY=run_full_v3_processing(resume=True)\n",
    "else: print(\"FULL V3: INCOMPLETE / NOT RUN; cell không chạy full mode.\")"
   ]
  },
