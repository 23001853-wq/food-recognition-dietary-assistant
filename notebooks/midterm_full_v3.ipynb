    "    from IPython.display import display\n",
    "except ImportError:\n",
    "    def display(value):\n",
    "        \"\"\"Fallback display for limited non-notebook smoke-test environments.\"\"\"\n",
    "        plt.show()\n",
    "from PIL import Image, ImageOps\n",
    "from skimage.feature import hog as skimage_hog\n",
    "\n",
    "def find_repository_root(start=None):\n",
    "    \"\"\"Tìm repository từ thư mục hiện tại hoặc thư mục cha.\"\"\"\n",
    "    origin=Path.cwd() if start is None else Path(start)\n",
    "    for candidate in (origin,*origin.parents,*Path.cwd().parents):\n",
    "        if (candidate/\"src/food_assistant/ml/image_ops.py\").is_file(): return candidate\n",
    "    raise FileNotFoundError(\"Không tìm thấy repository Food Recognition.\")\n",
    "REPO_ROOT=find_repository_root()\n",
    "SOURCE_DIR=REPO_ROOT/\"src\"\n",
    "if str(SOURCE_DIR) not in sys.path: sys.path.insert(0,str(SOURCE_DIR))\n",
    "from food_assistant.ml import image_ops\n",
    "from food_assistant.data_pipeline.atomic import resource_lock\n",
    "MANIFEST_DIR=REPO_ROOT/\"data/splits/v3\"\n",
    "MANIFEST_PATH=MANIFEST_DIR/\"dataset_manifest.csv\"\n",
    "METADATA_PATH=MANIFEST_DIR/\"dataset_metadata.json\"\n",
    "LABELS_PATH=MANIFEST_DIR/\"labels.json\"\n",
    "for path in (MANIFEST_PATH,METADATA_PATH,LABELS_PATH):\n",
    "    if not path.is_file(): raise FileNotFoundError(f\"Thiếu input v3: {path}\")\n",
    "METADATA=json.loads(METADATA_PATH.read_text(encoding=\"utf-8\"))\n",
    "LABEL_DOC=json.loads(LABELS_PATH.read_text(encoding=\"utf-8\"))\n",
    "if METADATA.get(\"dataset_version\")!=\"v3\" or METADATA.get(\"manifest_schema_version\")!=\"3.0\" or METADATA.get(\"complete\") is not True or LABEL_DOC.get(\"dataset_version\")!=\"v3\":\n",
    "    raise ValueError(\"Metadata/labels không xác nhận cleaned v3 schema 3.0.\")\n",
    "RAW_ROOT=(MANIFEST_DIR/METADATA[\"root\"]).resolve()\n",
    "if not RAW_ROOT.is_dir(): raise FileNotFoundError(f\"Raw root không tồn tại: {RAW_ROOT}\")\n",
    "with MANIFEST_PATH.open(encoding=\"utf-8\",newline=\"\") as handle: ROWS=list(csv.DictReader(handle))\n",
    "LABELS=LABEL_DOC[\"labels\"]\n",
    "CLASS_NAMES={int(x[\"class_id\"]):x[\"class_key\"] for x in LABELS}\n",
    "SPLIT_COUNTS=Counter(row[\"split\"] for row in ROWS)\n",
    "if not ROWS or sorted(CLASS_NAMES)!=list(range(len(LABELS))): raise ValueError(\"Manifest rỗng hoặc class ids sai.\")\n",
    "if len({row[\"image_id\"] for row in ROWS})!=len(ROWS): raise ValueError(\"image_id trùng trong manifest.\")\n",
    "if dict(SPLIT_COUNTS)!=METADATA.get(\"split_counts\") or len(ROWS)!=sum(METADATA[\"split_counts\"].values()) or len(LABELS)!=101:\n",
    "    raise ValueError(\"Counts manifest/metadata không khớp.\")\n",
    "if any(int(r[\"class_id\"]) not in CLASS_NAMES or CLASS_NAMES[int(r[\"class_id\"])]!=r[\"class_key\"] for r in ROWS):\n",
    "    raise ValueError(\"Class mapping không khớp labels.json.\")\n",
    "def sha256_file(path):\n",
    "    \"\"\"Hash manifest metadata cục bộ, không hash ảnh.\"\"\"\n",
    "    digest=hashlib.sha256()\n",
    "    with path.open(\"rb\") as handle:\n",
    "        for chunk in iter(lambda:handle.read(1024*1024),b\"\"): digest.update(chunk)\n",
    "    return digest.hexdigest()\n",
    "MANIFEST_SHA256=sha256_file(MANIFEST_PATH)\n",
    "DATASET_FINGERPRINT=METADATA.get(\"v3_fingerprint\")\n",
    "if not DATASET_FINGERPRINT: raise ValueError(\"Thiếu v3_fingerprint.\")\n",
