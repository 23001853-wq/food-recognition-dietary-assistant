    "# SETUP — chạy một lần sau khi mở kernel\n",
    "from __future__ import annotations\n",
    "import csv, hashlib, json, os, random, sys, tempfile, time\n",
    "from collections import Counter\n",
    "from pathlib import Path\n",
    "import cv2\n",
    "os.environ.setdefault(\"MPLCONFIGDIR\", str(Path(tempfile.gettempdir()) / \"food101_mplconfig\"))\n",
