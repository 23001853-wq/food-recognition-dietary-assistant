    "ARTIFACT_ROOT.mkdir(parents=True,exist_ok=True)\n",
    "print(f\"Root={REPO_ROOT}; raw={RAW_ROOT}\")\n",
    "print(f\"v3={DATASET_FINGERPRINT}; manifest sha256={MANIFEST_SHA256}\")\n",
    "print(f\"Classes={len(LABELS)}; images={len(ROWS):,}; splits={dict(SPLIT_COUNTS)}\")\n",
    "print(\"Setup chưa decode ảnh.\")"
