    "# CONFIG — thay N_IMAGES / SEED rồi chạy lại viewer bất kỳ\n",
    "N_IMAGES=15\n",
    "SEED=2026\n",
    "SPLITS=[\"train\",\"val\"]\n",
    "SAMPLING=\"random\"  # random hoặc per_class\n",
    "SAVE_PREVIEWS=True\n",
    "PAGE_SIZE=8\n",
    "OUTPUT_SIZE=(224,224)\n",
    "if isinstance(N_IMAGES,bool) or not isinstance(N_IMAGES,int) or N_IMAGES<1: raise ValueError(\"N_IMAGES phải >=1.\")\n",
    "if isinstance(SEED,bool) or not isinstance(SEED,int): raise ValueError(\"SEED phải là số nguyên.\")\n",
    "if SAMPLING not in {\"random\",\"per_class\"}: raise ValueError(\"SAMPLING không hợp lệ.\")\n",
    "if not SPLITS or any(x not in {\"train\",\"val\",\"test\"} for x in SPLITS): raise ValueError(\"SPLITS không hợp lệ.\")\n",
    "print(f\"N={N_IMAGES}; seed={SEED}; splits={SPLITS}; sampling={SAMPLING}\")"
