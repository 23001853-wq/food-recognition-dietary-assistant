    "# COMMON UTILITIES — sampling, safe paths, transformations, cache và rendering\n",
    "def select_samples(n=None,seed=None,splits=None,sampling=None):\n",
    "    \"\"\"Chọn mẫu deterministic từ manifest, không decode ảnh chưa chọn.\"\"\"\n",
    "    n=N_IMAGES if n is None else n; seed=SEED if seed is None else seed\n",
    "    allowed=SPLITS if splits is None else list(splits); mode=SAMPLING if sampling is None else sampling\n",
    "    rows=[r for r in ROWS if r[\"split\"] in allowed]\n",
    "    if isinstance(n,bool) or not isinstance(n,int) or not 1<=n<=len(rows): raise ValueError(f\"n phải trong [1,{len(rows)}].\")\n",
    "    rng=random.Random(seed)\n",
    "    if mode==\"random\": return rng.sample(rows,n)\n",
    "    if mode!=\"per_class\": raise ValueError(\"sampling phải random/per_class.\")\n",
    "    buckets={}\n",
    "    for row in rows: buckets.setdefault(int(row[\"class_id\"]),[]).append(row)\n",
    "    for group in buckets.values(): group.sort(key=lambda r:r[\"image_id\"]); rng.shuffle(group)\n",
    "    result=[]\n",
    "    while len(result)<n:\n",
    "        progressed=False\n",
    "        for class_id in sorted(buckets):\n",
    "            if buckets[class_id] and len(result)<n: result.append(buckets[class_id].pop()); progressed=True\n",
    "        if not progressed: break\n",
    "    return result\n",
    "\n",
    "def image_path(row):\n",
    "    \"\"\"Resolve manifest path trong raw root, từ chối traversal và file thiếu.\"\"\"\n",
    "    rel=Path(row[\"relative_path\"])\n",
    "    if rel.is_absolute() or \"..\" in rel.parts or \"\\\\\" in row[\"relative_path\"]: raise ValueError(\"Unsafe manifest path.\")\n",
    "    path=(RAW_ROOT/rel).resolve()\n",
    "    if not path.is_relative_to(RAW_ROOT) or not path.is_file(): raise FileNotFoundError(row[\"relative_path\"])\n",
    "    return path\n",
    "\n",
    "def read_rgb(row):\n",
    "    \"\"\"Decode đúng một ảnh, áp EXIF orientation, trả RGB uint8 HWC.\"\"\"\n",
    "    with Image.open(image_path(row)) as opened: return np.asarray(ImageOps.exif_transpose(opened).convert(\"RGB\"),dtype=np.uint8).copy()\n",
    "\n",
    "def params(name):\n",
    "    \"\"\"Tham số demo có version trong cache identity.\"\"\"\n",
    "    return {\"brightness\":{\"factor\":1.25},\"contrast\":{\"factor\":1.35},\"gamma\":{\"gamma\":0.75},\n",
    "    \"resize\":{\"size\":OUTPUT_SIZE,\"interpolation\":\"area\"},\"center_crop\":{\"size\":(224,224)},\n",
    "    \"horizontal_flip\":{},\"rotation\":{\"degrees\":12},\"gaussian_blur\":{\"kernel\":5,\"sigma\":1.0},\n",
    "    \"median_filter\":{\"kernel\":3},\"gaussian_noise_filter\":{\"fraction\":0.06,\"seed\":17,\"kernel\":5},\n",
    "    \"salt_pepper_filter\":{\"fraction\":0.025,\"seed\":17,\"kernel\":3},\"threshold\":{\"threshold\":127},\n",
    "    \"erosion\":{\"kernel\":5},\"dilation\":{\"kernel\":5},\"opening\":{\"kernel\":5},\"closing\":{\"kernel\":5},\n",
    "    \"sobel\":{\"kernel\":3},\"canny\":{\"low\":80,\"high\":160},\"connected_components\":{\"minimum_area\":500},\n",
    "    \"regions\":{\"minimum_area\":500},\"classical_segmentation\":{\"gaussian\":5,\"morphology\":5,\"minimum_area\":500,\"threshold\":\"Otsu\"},\n",
    "    \"hog\":{\"size\":OUTPUT_SIZE,\"orientations\":9,\"pixels_per_cell\":(8,8),\"cells_per_block\":(2,2)},\n",
    "    \"rgb_channels\":{},\"bgr_conversion\":{},\"grayscale\":{},\"hsv_channels\":{},\"layout_normalization\":{}}[name]\n",
    "\n",
    "def otsu(gray):\n",
    "    \"\"\"Tạo mask intensity Otsu; không phải segmentation ground truth.\"\"\"\n",
    "    value,mask=cv2.threshold(gray,0,255,cv2.THRESH_BINARY+cv2.THRESH_OTSU)\n",
    "    return (mask>0).astype(np.uint8),float(value)\n",
    "\n",
    "def draw_boxes(image,regions):\n",
    "    \"\"\"Vẽ vùng lên bản sao RGB.\"\"\"\n",
    "    result=image.copy()\n",
    "    for box in regions: cv2.rectangle(result,(box[\"x\"],box[\"y\"]),(box[\"x\"]+box[\"width\"],box[\"y\"]+box[\"height\"]),(255,35,25),2)\n",
    "    return result\n"
   ]
