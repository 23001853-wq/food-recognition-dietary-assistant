    "\n",
    "def compute(image,name):\n",
    "    \"\"\"Tính một kỹ thuật trên một RGB uint8, trả outputs và metrics nhỏ.\"\"\"\n",
    "    if image.dtype!=np.uint8 or image.ndim!=3 or image.shape[2]!=3: raise ValueError(\"Input phải RGB uint8 HWC.\")\n",
    "    p=params(name); gray=image_ops.rgb_to_grayscale(image); stats={\"input_shape\":list(image.shape),\"input_dtype\":str(image.dtype)}\n",
    "    if name==\"rgb_channels\": outputs={\"RGB\":image,\"Red\":image[:,:,0],\"Green\":image[:,:,1],\"Blue\":image[:,:,2]}\n",
    "    elif name==\"bgr_conversion\":\n",
    "        bgr=image_ops.rgb_to_bgr(image); outputs={\"RGB\":image,\"BGR\":bgr[:,:,::-1].copy(),\"Back to RGB\":image_ops.bgr_to_rgb(bgr)}\n",
    "    elif name==\"grayscale\": outputs={\"Grayscale\":gray}\n",
    "    elif name==\"hsv_channels\":\n",
    "        hsv=image_ops.rgb_to_hsv(image); outputs={\"Hue (0-179)\":hsv[:,:,0],\"Saturation\":hsv[:,:,1],\"Value\":hsv[:,:,2],\"HSV to RGB\":image_ops.hsv_to_rgb(hsv)}\n",
    "    elif name==\"layout_normalization\":\n",
    "        unit=image_ops.to_float01(image); chw=image_ops.hwc_to_chw(unit); outputs={\"RGB\":image,\"Float [0,1]\":unit,\"CHW channel 0\":chw[0]}\n",
    "        stats.update({\"HWC\":list(image.shape),\"CHW\":list(chw.shape),\"dtype\":str(unit.dtype),\"range\":[float(unit.min()),float(unit.max())]})\n",
    "    elif name==\"brightness\": outputs={\"Brightness\":image_ops.adjust_brightness(image,p[\"factor\"])}\n",
    "    elif name==\"contrast\": outputs={\"Contrast\":image_ops.adjust_contrast(image,p[\"factor\"])}\n",
    "    elif name==\"gamma\": outputs={\"Gamma\":image_ops.gamma_correct(image,p[\"gamma\"])}\n",
    "    elif name==\"resize\": outputs={\"Resize\":image_ops.resize_image(image,p[\"size\"],p[\"interpolation\"])}\n",
    "    elif name==\"center_crop\":\n",
    "        size=(min(p[\"size\"][0],image.shape[0]),min(p[\"size\"][1],image.shape[1])); outputs={\"Center crop\":image_ops.center_crop(image,size)}; stats[\"crop_size\"]=size\n",
    "    elif name==\"horizontal_flip\": outputs={\"Horizontal flip\":image_ops.horizontal_flip(image)}\n",
    "    elif name==\"rotation\": outputs={\"Rotation\":image_ops.rotate_image(image,p[\"degrees\"],enabled=True)}\n",
    "    elif name==\"gaussian_blur\": outputs={\"Gaussian Blur\":image_ops.gaussian_blur(image,p[\"kernel\"],p[\"sigma\"])}\n",
    "    elif name==\"median_filter\": outputs={\"Median Filter\":image_ops.median_filter(image,p[\"kernel\"])}\n",
    "    elif name==\"gaussian_noise_filter\":\n",
    "        rng=np.random.default_rng(p[\"seed\"]); noisy=np.rint(np.clip(image.astype(np.float32)/255+rng.normal(0,p[\"fraction\"],image.shape),0,1)*255).astype(np.uint8)\n",
    "        filtered=image_ops.gaussian_blur(noisy,p[\"kernel\"],1.0); outputs={\"Reference\":image,\"Noise\":noisy,\"Gaussian Blur\":filtered}\n",
    "        stats[\"mse_vs_reference\"]=float(np.mean((image.astype(np.float32)-filtered.astype(np.float32))**2))\n",
    "    elif name==\"salt_pepper_filter\":\n",
    "        rng=np.random.default_rng(p[\"seed\"]); noisy=image.copy(); amount=int(image.shape[0]*image.shape[1]*p[\"fraction\"])\n",
    "        coords=(rng.integers(0,image.shape[0],amount),rng.integers(0,image.shape[1],amount)); half=amount//2\n",
    "        noisy[coords[0][:half],coords[1][:half]]=0; noisy[coords[0][half:],coords[1][half:]]=255\n",
    "        filtered=image_ops.median_filter(noisy,p[\"kernel\"]); outputs={\"Reference\":image,\"Salt-Pepper\":noisy,\"Median\":filtered}\n",
    "        stats[\"mse_vs_reference\"]=float(np.mean((image.astype(np.float32)-filtered.astype(np.float32))**2))\n",
    "    elif name==\"threshold\": outputs={\"Original\":image,\"Gray\":gray,\"Mask\":image_ops.threshold_mask(image,p[\"threshold\"])}\n",
    "    elif name in {\"erosion\",\"dilation\",\"opening\",\"closing\"}:\n",
    "        mask,_=otsu(gray); outputs={\"Original\":image,\"Input mask\":mask,name.title():getattr(image_ops,name)(mask,p[\"kernel\"])}\n",
    "    elif name in {\"connected_components\",\"regions\"}:\n",
    "        mask,t=otsu(gray); boxes=image_ops.extract_regions(mask,p[\"minimum_area\"]); count,component_labels,_=image_ops.connected_components(mask)\n",
    "        outputs={\"Original\":image,\"Otsu mask\":mask,\"Component labels\":component_labels}\n",
    "        if name==\"regions\": outputs[\"Boxes\"] = draw_boxes(image,boxes)\n",
    "        stats.update({\"threshold\":t,\"component_count\":count,\"regions_above_min\":len(boxes),\"foreground_area\":int(mask.sum()),\"foreground_ratio\":float(mask.mean())})\n",
    "    elif name in {\"sobel\",\"canny\"}:\n",
    "        edges=image_ops.sobel_magnitude(gray,p[\"kernel\"]) if name==\"sobel\" else image_ops.canny_edges(gray,p[\"low\"],p[\"high\"])\n",
    "        outputs={\"Original\":image,\"Gray\":gray,\"Edges\":edges}\n",
    "    elif name==\"classical_segmentation\":\n",
    "        blurred=image_ops.gaussian_blur(gray,p[\"gaussian\"],1.0); mask,t=otsu(blurred)\n",
    "        cleaned=image_ops.closing(image_ops.opening(mask,p[\"morphology\"]),p[\"morphology\"]); boxes=image_ops.extract_regions(cleaned,p[\"minimum_area\"])\n",
    "        outputs={\"Original\":image,\"Gray\":gray,\"Gaussian\":blurred,\"Otsu mask\":mask,\"Opening+Closing\":cleaned,\"Regions/boxes\":draw_boxes(image,boxes)}\n",
    "        stats.update({\"otsu_threshold\":t,\"regions\":len(boxes),\"foreground_area\":int(cleaned.sum()),\"foreground_ratio\":float(cleaned.mean())})\n",
    "    elif name==\"hog\":\n",
    "        p=params(name); resized=cv2.resize(gray,(p[\"size\"][1],p[\"size\"][0]),interpolation=cv2.INTER_AREA)\n",
    "        feature,visual=skimage_hog(resized,orientations=p[\"orientations\"],pixels_per_cell=p[\"pixels_per_cell\"],cells_per_block=p[\"cells_per_block\"],block_norm=\"L2-Hys\",visualize=True)\n",
    "        outputs={\"Original\":image,\"HOG visualization\":visual}; stats[\"feature_length\"]=int(feature.size)\n",
    "    else: raise KeyError(name)\n",
    "    if not any(key in outputs for key in (\"Original\",\"Original reference\",\"RGB\")):\n",
    "        outputs={\"Original\":image,**outputs}\n",
    "    stats[\"output_shapes\"]={key:list(value.shape) for key,value in outputs.items()}\n",
    "    return outputs,stats\n",
    "\n",
    "def cache_path(row,name):\n",
    "    \"\"\"Tạo cache id theo fingerprint, image ID, technique và config.\"\"\"\n",
    "    identity={\"processor_version\":\"midterm-v1.1\",\"source\":DATASET_FINGERPRINT,\"manifest\":MANIFEST_SHA256,\"id\":row[\"image_id\"],\"name\":name,\"params\":params(name)}\n",
    "    token=hashlib.sha256(json.dumps(identity,sort_keys=True,default=list).encode()).hexdigest()\n",
    "    return PREVIEW_CACHE/f\"{token}.npz\"\n",
    "\n",
    "def get_preview(row,name):\n",
    "    \"\"\"Đọc cache hoặc chỉ decode/xử lý đúng ảnh mẫu này.\"\"\"\n",
    "    path=cache_path(row,name)\n",
    "    if path.is_file():\n",
    "        try:\n",
    "            with np.load(path,allow_pickle=False) as archive:\n",
    "                meta=json.loads(str(archive[\"meta\"].item()))\n",
    "                return {key:archive[value].copy() for key,value in meta[\"keys\"].items()},meta[\"stats\"],True\n",
    "        except (OSError,ValueError,KeyError,json.JSONDecodeError): pass\n",
    "    outputs,stats=compute(read_rgb(row),name)\n",
    "    if SAVE_PREVIEWS:\n",
    "        path.parent.mkdir(parents=True,exist_ok=True)\n",
    "        with tempfile.NamedTemporaryFile(prefix=\".preview-\",suffix=\".npz\",dir=path.parent,delete=False) as handle: temp=Path(handle.name)\n",
    "        try:\n",
    "            arrays={}; keys={}\n",
    "            for index,(key,value) in enumerate(outputs.items()): keys[key]=f\"a{index}\"; arrays[f\"a{index}\"]=value\n",
    "            arrays[\"meta\"]=np.asarray(json.dumps({\"keys\":keys,\"stats\":stats},ensure_ascii=False))\n",
    "            np.savez_compressed(temp,**arrays); os.replace(temp,path)\n",
    "        finally:\n",
    "            if temp.exists(): temp.unlink()\n",
    "    return outputs,stats,False\n",
    "\n",
    "def render_comparison(row,name,outputs,stats):\n",
    "    \"\"\"Vẽ ảnh gốc/kết quả và lưu PNG preview bên ngoài dataset.\"\"\"\n",
    "    fig,axes=plt.subplots(1,len(outputs),figsize=(4*len(outputs),4),squeeze=False)\n",
    "    for axis,(title,array) in zip(axes[0],outputs.items()):\n",
    "        if array.ndim==2:\n",
    "            if array.dtype==np.bool_ or (np.issubdtype(array.dtype,np.floating) and array.min()>=0 and array.max()<=1): axis.imshow(array,cmap=\"gray\",vmin=0,vmax=1)\n",
    "            elif np.issubdtype(array.dtype,np.floating): axis.imshow(array,cmap=\"gray\")\n",
    "            else: axis.imshow(array,cmap=\"gray\",vmin=0,vmax=255)\n",
    "        elif array.ndim==3 and array.shape[2]==3:\n",
    "            axis.imshow(np.clip(array,0,1) if np.issubdtype(array.dtype,np.floating) and array.min()>=0 and array.max()<=1 else array)\n",
    "        axis.set_title(f\"{title} ({array.shape[1]}x{array.shape[0]})\",fontsize=9); axis.axis(\"off\")\n",
    "    h,w=stats[\"input_shape\"][:2]\n",
    "    metric_summary={key:value for key,value in stats.items() if key not in {\"input_shape\",\"input_dtype\",\"output_shapes\"}}\n",
    "    fig.suptitle(f\"{name.upper()} | {row['image_id']} | {row['class_key']} | {row['split']} | original {w}x{h} | {params(name)} | metrics={metric_summary}\",fontsize=9)\n",
    "    fig.tight_layout()\n",
    "    if SAVE_PREVIEWS:\n",
    "        PREVIEW_IMAGES.mkdir(parents=True,exist_ok=True)\n",
    "        token=hashlib.sha256(row[\"image_id\"].encode()).hexdigest()[:12]\n",
    "        param_token=hashlib.sha256(json.dumps(params(name),sort_keys=True,default=list).encode()).hexdigest()[:8]\n",
    "        fig.savefig(PREVIEW_IMAGES/f\"{name}_{token}_{param_token}.png\",dpi=140,bbox_inches=\"tight\")\n",
    "    display(fig); plt.close(fig)\n",
    "\n",
    "def show_technique(name,n=None,seed=None,splits=None):\n",
    "    \"\"\"Render paged examples without ever invoking full processing.\"\"\"\n",
    "    n=N_IMAGES if n is None else n; seed=SEED if seed is None else seed\n",
    "    rows=select_samples(n,seed,splits); records=[]\n",
    "    for start in range(0,len(rows),max(PAGE_SIZE,1)):\n",
    "        for row in rows[start:start+max(PAGE_SIZE,1)]:\n",
    "            outputs,stats,hit=get_preview(row,name); stats={**stats,\"cache_hit\":hit}\n",
    "            render_comparison(row,name,outputs,stats)\n",
    "            records.append({\"sample_id\":len(records)+1,\"image_id\":row[\"image_id\"],\"split\":row[\"split\"],\"class_id\":int(row[\"class_id\"]),\"class_name\":row[\"class_key\"],\"relative_path\":row[\"relative_path\"],\"sampling_seed\":seed,\"sampling_policy\":SAMPLING,\"metrics\":stats})\n",
    "    sampling_dir=ARTIFACT_ROOT/\"sampling\"; sampling_dir.mkdir(parents=True,exist_ok=True)\n",
    "    sample_hash=hashlib.sha256(json.dumps([item[\"image_id\"] for item in records]).encode()).hexdigest()[:10]\n",
    "    sampling_path=sampling_dir/f\"{name}_n{n}_seed{seed}_{sample_hash}.json\"\n",
    "    with tempfile.NamedTemporaryFile(mode=\"w\",encoding=\"utf-8\",prefix=\".sampling-\",suffix=\".tmp\",dir=sampling_dir,delete=False) as handle:\n",
    "        temporary=Path(handle.name); json.dump({\"source_dataset\":\"Food-101 cleaned v3\",\"dataset_fingerprint\":DATASET_FINGERPRINT,\"manifest_sha256\":MANIFEST_SHA256,\"technique\":name,\"seed\":seed,\"policy\":SAMPLING,\"splits\":splits or SPLITS,\"sample_count\":len(records),\"samples\":records},handle,ensure_ascii=False,indent=2); handle.flush(); os.fsync(handle.fileno())\n",
    "    try: os.replace(temporary,sampling_path)\n",
    "    finally:\n",
    "        if temporary.exists(): temporary.unlink()\n",
    "    return records\n",
    "print(\"Common utilities ready; no image decoded.\")"
   ]
  },
